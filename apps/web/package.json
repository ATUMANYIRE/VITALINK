{
  "name": "vitalink-clinical-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3017",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3017",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0"
  },
  "type": "module"
}
